{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "ReverseProxy": {
    "Routes": {
      "identity-route": { "ClusterId": "identity-cluster", "Match": { "Path": "/api/identity/{**catch-all}" } },
      "movie-route": { "ClusterId": "movie-cluster", "Match": { "Path": "/api/movie/{**catch-all}" } },
      "cast-route": { "ClusterId": "cast-cluster", "Match": { "Path": "/api/cast/{**catch-all}" } },
      "facility-route": { "ClusterId": "facility-cluster", "Match": { "Path": "/api/facility/{**catch-all}" } },
      "schedule-route": { "ClusterId": "schedule-cluster", "Match": { "Path": "/api/schedule/{**catch-all}" } },
      "booking-route": { "ClusterId": "booking-cluster", "Match": { "Path": "/api/booking/{**catch-all}" } }
    },
    "Clusters": {
      "identity-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5001" } } },
      "movie-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5002" } } },
      "cast-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5003" } } },
      "facility-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5004" } } },
      "schedule-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5005" } } },
      "booking-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5006" } } }
    }
  }
}